# --- Database (Supabase) ---------------------------------------------------
# Vercel/production: Supabase *transaction pooler* URL (port 6543).
# Local: any Postgres 15+, e.g. postgres://postgres:postgres@localhost:5432/comunio
DATABASE_URL=

APP_URL=http://localhost:3000

# --- Auth (Clerk) — admin dashboard ----------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Comma-separated emails allowed into /admin (required in production)
ADMIN_EMAILS=
# Local only, when Clerk keys are not set: skip auth for /admin (ignored in production)
COMUNIO_DEV_AUTH_BYPASS=1

# --- Payments (Ifthenpay) --------------------------------------------------
# mock | ifthenpay. MB/MB WAY keys are stored per condominium in the DB.
PAYMENTS_PROVIDER=mock
IFTHENPAY_ANTI_PHISHING_KEY=
IFTHENPAY_MB_EXPIRY_DAYS=30

# --- Billing (Moloni, multi-company) ---------------------------------------
# mock | moloni. company/document set/product ids are stored per condominium.
BILLING_PROVIDER=mock
MOLONI_CLIENT_ID=
MOLONI_CLIENT_SECRET=
MOLONI_USERNAME=
MOLONI_PASSWORD=

# --- Vercel Cron -----------------------------------------------------------
CRON_SECRET=
